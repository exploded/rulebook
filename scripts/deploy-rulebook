#!/bin/bash
# /usr/local/bin/deploy-rulebook
# Runs as root (via sudo) during GitHub Actions deployments.
#
# To update this script on the server, include scripts/deploy-rulebook
# in the SCP bundle - it will self-update and re-exec before doing anything else.
# It also installs scripts/install-db-rulebook from the bundle.
#
# Templates and static assets are embedded in the binary, so the only artifact
# to install is the binary. The database is uploaded separately from the PC
# with install-db-rulebook; until it exists, the service is installed
# and enabled but not started.

set -e

DEPLOY_SRC="${1:-/tmp/rulebook-deploy}"
DEPLOY_DIR=/var/www/rulebook

# Self-update: if the bundle contains a newer version of this script, install
# it and re-exec so the rest of the deployment runs with the updated logic.
BUNDLE_SCRIPT="$DEPLOY_SRC/scripts/deploy-rulebook"
if [ -f "$BUNDLE_SCRIPT" ] && ! diff -q /usr/local/bin/deploy-rulebook "$BUNDLE_SCRIPT" > /dev/null 2>&1; then
    echo "[deploy] Updating deploy script from bundle..."
    install -m 755 "$BUNDLE_SCRIPT" /usr/local/bin/deploy-rulebook
    exec /usr/local/bin/deploy-rulebook "$@"
fi

BUNDLE_DB_SCRIPT="$DEPLOY_SRC/scripts/install-db-rulebook"
if [ -f "$BUNDLE_DB_SCRIPT" ]; then
    install -m 755 "$BUNDLE_DB_SCRIPT" /usr/local/bin/install-db-rulebook
fi

# Read the service owner from the installed unit - no hardcoded username.
SERVICE_USER=$(systemctl show rulebook --property=User --value)
SERVICE_GROUP=$(systemctl show rulebook --property=Group --value)

if [ -z "$SERVICE_USER" ]; then
    echo "[deploy] ERROR: Could not read User from rulebook.service"
    exit 1
fi

echo "[deploy] Stopping service..."
systemctl stop rulebook || true

echo "[deploy] Installing binary to $DEPLOY_DIR/rulebook (owner: $SERVICE_USER:$SERVICE_GROUP)..."
rm -f "$DEPLOY_DIR/rulebook"
cp "$DEPLOY_SRC/rulebook" "$DEPLOY_DIR/rulebook"
chmod +x "$DEPLOY_DIR/rulebook"
chown -R "$SERVICE_USER:$SERVICE_GROUP" "$DEPLOY_DIR"

echo "[deploy] Enabling service on boot..."
systemctl enable rulebook

echo "[deploy] Cleaning up..."
rm -rf "$DEPLOY_SRC"

if [ ! -f "$DEPLOY_DIR/rulebook.db" ]; then
    echo "[deploy] No $DEPLOY_DIR/rulebook.db yet - not starting the service."
    echo "[deploy] Upload it from the PC, then run: sudo install-db-rulebook /tmp/rulebook.db"
    exit 0
fi

echo "[deploy] Starting service..."
systemctl start rulebook

echo "[deploy] Verifying service is active..."
for i in 1 2 3 4 5; do
    if systemctl is-active --quiet rulebook; then
        break
    fi
    sleep 1
done
if ! systemctl is-active --quiet rulebook; then
    echo "[deploy] ERROR: Service failed to start. Status:"
    systemctl status rulebook --no-pager --lines=30
    exit 1
fi

echo "[deploy] Done - rulebook is running."
