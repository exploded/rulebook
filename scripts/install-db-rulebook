#!/bin/bash
# /usr/local/bin/install-db-rulebook
# Replaces the live database with a snapshot uploaded from the PC, then
# restarts the service. Run with sudo:
#   sudo install-db-rulebook /tmp/rulebook.db
#
# Make the snapshot on the PC with `go run ./cmd/snapshot-db` (writes
# dist/rulebook.db). The web app keeps its database open, so it must restart
# to see the new file.

set -e

SRC="${1:-/tmp/rulebook.db}"
DEPLOY_DIR=/var/www/rulebook
DB="$DEPLOY_DIR/rulebook.db"

if [ ! -f "$SRC" ]; then
    echo "[db] ERROR: $SRC not found"
    exit 1
fi
if [ "$(head -c 15 "$SRC")" != "SQLite format 3" ]; then
    echo "[db] ERROR: $SRC is not an SQLite database"
    exit 1
fi

SERVICE_USER=$(systemctl show rulebook --property=User --value)
SERVICE_GROUP=$(systemctl show rulebook --property=Group --value)
if [ -z "$SERVICE_USER" ]; then
    echo "[db] ERROR: Could not read User from rulebook.service"
    exit 1
fi

echo "[db] Installing $SRC as $DB..."
install -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 640 "$SRC" "$DB.new"
mv -f "$DB.new" "$DB"
rm -f "$DB-wal" "$DB-shm"
rm -f "$SRC"

if [ ! -x "$DEPLOY_DIR/rulebook" ]; then
    echo "[db] Done. No binary yet - the next GitHub Actions deploy starts the service."
    exit 0
fi

echo "[db] Restarting service..."
systemctl restart rulebook
for i in 1 2 3 4 5; do
    if systemctl is-active --quiet rulebook; then
        break
    fi
    sleep 1
done
if ! systemctl is-active --quiet rulebook; then
    echo "[db] ERROR: Service failed to start. Status:"
    systemctl status rulebook --no-pager --lines=30
    exit 1
fi
echo "[db] Done - rulebook is running on the new database."
